# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# ---------------------------------------------------------------
# ChangeNOW (required for ChangeNOW quotes and swaps)
# Get a free API key from ChangeNOW's partner program.
# Any commission is linked to the partner account that owns this key
# and is set on ChangeNOW's side, not in this code.
# ---------------------------------------------------------------
CHANGENOW_API_KEY=

# ---------------------------------------------------------------
# Godex (required for Godex quotes and swaps)
# ---------------------------------------------------------------
GODEX_API_KEY=
# Optional. Leave blank for no affiliate commission.
GODEX_AFFILIATE_ID=

# ---------------------------------------------------------------
# Email receipts via Brevo SMTP (optional)
# Leave the login and password blank to disable emails entirely.
# ---------------------------------------------------------------
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_PASSWORD=
# The address receipts are sent from.
EMAIL_FROM_ADDRESS=
# The address replies to receipts go to.
EMAIL_REPLY_TO_ADDRESS=
# ---------------------------------------------------------------
# Development
# Set to 1 to enable the mock provider (fake quotes, fake deposit
# address) and the test routes. NEVER enable this on a live server.
# ---------------------------------------------------------------
JUSTSWAPPING_DEV=0